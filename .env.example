# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=True

# Какой конфиг использовать.
#   development — SQLite, DEBUG=True, для локального запуска.
#   prod        — PostgreSQL, security-настройки, для Docker и прода.
#   ci          — PostgreSQL, для CI и pytest.
#   test        — SQLite in-memory, для быстрых локальных тестов.
DJANGO_SETTINGS_MODULE=config.settings.development

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (обязательно для config.settings.prod и config.settings.ci)
POSTGRES_DB=hopbarley
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email (по умолчанию письма идут в консоль)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Hop & Barley <noreply@hopandbarley.com>

# Опционально: разрешить DEBUG=True в prod-настройках (только для отладки)
# ALLOW_DEBUG_IN_PROD=1
