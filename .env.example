# ─── Django ───
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=True

# Какой конфиг использовать.
#   development — SQLite, DEBUG=True, для локального запуска.
#   prod        — PostgreSQL, security-настройки, для Docker и прода.
#   ci          — PostgreSQL, для CI и pytest.
#   test        — SQLite in-memory, для быстрых локальных тестов.
DJANGO_SETTINGS_MODULE=config.settings.development

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── PostgreSQL (обязательно для config.settings.prod и config.settings.ci) ───
POSTGRES_DB=hopbarley
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Redis (кеш аналитических метрик GraphQL) ───
# Если не задан — Django fallback на LocMemCache (in-memory).
# ВНИМАНИЕ: LocMemCache живёт в памяти процесса. При нескольких воркерах
# gunicorn каждый процесс имеет свой кеш — метрики не шарятся между воркерами.
# Для продакшена Redis обязателен (см. config/settings/prod.py — fail-fast).
#
#   Локально (Redis на хосте):      redis://localhost:6379/0
#   В Docker Compose (сервис redis): redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ─── Email (по умолчанию письма идут в консоль) ───
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Hop & Barley <noreply@hopandbarley.com>

# ─── Опционально ───
# ALLOW_DEBUG_IN_PROD=1

# ─── Celery (фоновые задачи) ───
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
