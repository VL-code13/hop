[run]
omit =
    */migrations/*
    */tests/*
    */tests.py
    */apps.py
    */wsgi.py
    */asgi.py
    manage.py
    config/settings/*
    .venv/*
    venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    class .*\bMeta\b: